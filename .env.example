# ---------------------------------------------------------------------------
# VoteChain environment (copy to .env at the repository root)
# Shared by contracts/ (Hardhat + Foundry), backend/ and frontend/ (VITE_* keys)
# ---------------------------------------------------------------------------

# --- Blockchain -------------------------------------------------------------
# Local demo (Hardhat node or Anvil on :8545)
RPC_URL=http://127.0.0.1:8545
NETWORK=localhost

# Sepolia testnet (Chapter 4 screenshots / Phase 6 deployment)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# Deployer / INEC admin private key for Sepolia (NEVER commit a real key)
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Backend ----------------------------------------------------------------
PORT=4000
CORS_ORIGIN=*
# PostgreSQL display cache (docker compose up -d postgres). Leave empty for chain-only mode.
DATABASE_URL=postgres://votechain:votechain@127.0.0.1:5432/votechain
INDEXER_POLL_MS=3000
SESSION_TTL_SECONDS=43200
# Expose deployments/demo-accounts.json through /api/demo-accounts (local demo only!)
DEMO_MODE=true

# IPFS: local (content-addressed store on disk) | kubo (docker compose up -d ipfs) | pinata
IPFS_PROVIDER=local
KUBO_API_URL=http://127.0.0.1:5001
KUBO_GATEWAY_URL=http://127.0.0.1:8080
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
MAX_UPLOAD_BYTES=15728640

# --- Frontend (Vite only exposes VITE_* variables to the browser) ------------
VITE_API_URL=http://localhost:4000
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_NETWORK=localhost
# Show the demo role switcher (uses the publicly known test keys of the local node)
VITE_DEMO_MODE=true
